{
  "version": 2,
  "framework": null,
  "headers": [
    {
      "source": "/assets/(.*).glb",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/metrik",
      "destination": "/api/metrik.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
